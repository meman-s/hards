[MASTER]
jobs=0
suggestion-mode=yes

[MESSAGES CONTROL]
disable=missing-function-docstring,
        missing-module-docstring

[FORMAT]
max-line-length=120
indent-string='    '

[BASIC]
good-names=i,j,k,ex,Run,_,id,db

[DESIGN]
max-args=10
max-locals=20
max-returns=10
max-branches=20
max-statements=50
max-parents=10
max-attributes=15
min-public-methods=0
max-public-methods=30

[IMPORTS]
preferred-module=collections.abc

[EXCEPTIONS]
overgeneral-exceptions=Exception
